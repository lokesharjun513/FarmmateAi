APP_NAME=FarmMate AI
APP_VERSION=1.0.0
APP_ENV=development

DATABASE_URL=postgresql+psycopg://postgres.gprkvgscdoruqskixsev:BharathSonuRam@aws-1-ap-southeast-1.pooler.supabase.com:5432/postgres

JWT_SECRET_KEY=replace-with-a-secure-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

AI_API_URL=https://your-provider.example/v1
AI_API_KEY=replace-with-your-api-key
AI_MODEL=your-model-name

AI_TEMPERATURE=0.2
AI_MAX_TOKENS=4096
AI_REQUEST_TIMEOUT=60

# WeatherAPI.com forecast API key (https://www.weatherapi.com/).
# Required for the weather endpoints; keep it secret and never
# commit it. Set it in the deployment environment (e.g. Render).
WEATHERAPI_API_KEY=replace-with-your-weatherapi-api-key

# Firebase Admin SDK service account key.
# Keep the JSON file outside the repository and restrict its permissions.
FIREBASE_SERVICE_ACCOUNT_KEY_PATH=/secure/path/farmmate-firebase-service-account.json
